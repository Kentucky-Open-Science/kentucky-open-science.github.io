{
  "name": "kentucky-open-science-site",
  "version": "0.1.0",
  "private": true,
  "description": "Kentucky Open Science wiki (generated from public GitHub data) + the KOS task board (WCAG 2.1 AA harness).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.js",
    "fetch": "node tools/fetch-projects.js && node .github/kos/leaderboard.js",
    "serve": "node tools/build.js && node tests/serve.js",
    "test": "playwright test",
    "report": "node tests/kos-report.js reports/playwright.json reports/kos-results.json",
    "baseline": "node tests/kos-report.js --baseline reports/playwright.json tests/known-failures.json",
    "test:unit": "node --test \".github/kos/test/*.test.js\" \"tools/test/*.test.js\"",
    "test:board": "node --test \".github/kos/test/*.test.js\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "html-validate": "11.16.0"
  }
}
